display:
  name: Metrics Cardinality Overview
duration: 1h
layouts:
  - kind: Grid
    spec:
      display:
        collapse:
          open: true
        title: Cardinality Outliers
      items:
        - content:
            $ref: '#/spec/panels/0_0'
          height: 6
          width: 3
          x: 0
          'y': 0
        - content:
            $ref: '#/spec/panels/0_1'
          height: 6
          width: 9
          x: 3
          'y': 0
        - content:
            $ref: '#/spec/panels/0_2'
          height: 6
          width: 3
          x: 12
          'y': 0
        - content:
            $ref: '#/spec/panels/0_3'
          height: 6
          width: 9
          x: 15
          'y': 0
  - kind: Grid
    spec:
      display:
        title: Cluster Cardinality
      items:
        - content:
            $ref: '#/spec/panels/1_0'
          height: 8
          width: 12
          x: 0
          'y': 0
        - content:
            $ref: '#/spec/panels/1_1'
          height: 8
          width: 12
          x: 12
          'y': 0
  - kind: Grid
    spec:
      display:
        title: Metric Cardinality
      items:
        - content:
            $ref: '#/spec/panels/2_0'
          height: 8
          width: 12
          x: 0
          'y': 0
        - content:
            $ref: '#/spec/panels/2_1'
          height: 8
          width: 12
          x: 12
          'y': 0
  - kind: Grid
    spec:
      display:
        collapse:
          open: false
        title: Global Recording Rules Cardinality
      items:
        - content:
            $ref: '#/spec/panels/3_0'
          height: 10
          width: 10
          x: 0
          'y': 0
        - content:
            $ref: '#/spec/panels/3_1'
          height: 10
          width: 14
          x: 10
          'y': 0
  - kind: Grid
    spec:
      display:
        collapse:
          open: false
        title: Total Cardinality
      items:
        - content:
            $ref: '#/spec/panels/4_0'
          height: 11
          width: 24
          x: 0
          'y': 0
panels:
  '0_0':
    kind: Panel
    spec:
      display:
        name: Cluster Outliers
      plugin:
        kind: StatChart
        spec:
          calculation: last-number
          thresholds:
            defaultColor: green
            mode: absolute
            steps:
              - color: red
                value: 1
      queries:
        - kind: TimeSeriesQuery
          spec:
            plugin:
              kind: PrometheusTimeSeriesQuery
              spec:
                datasource:
                  kind: PrometheusDatasource
                  name: rbac-query-proxy-datasource
                query: 'count(last_over_time(cluster:cardinality[35m]) > ignoring(cluster) group_left avg(last_over_time(cluster:cardinality[35m])) + 3 * stddev(last_over_time(cluster:cardinality[35m])))'
  '1_0':
    kind: Panel
    spec:
      display:
        name: Cardinality Over Time
      plugin:
        kind: TimeSeriesChart
        spec:
          legend:
            mode: list
            position: bottom
          visual:
            display: line
            lineWidth: 1
            palette:
              mode: auto
      queries:
        - kind: TimeSeriesQuery
          spec:
            plugin:
              kind: PrometheusTimeSeriesQuery
              spec:
                datasource:
                  kind: PrometheusDatasource
                  name: rbac-query-proxy-datasource
                query: 'topk(8, cluster:cardinality)'
                seriesNameFormat: '{{cluster}}'
  '0_1':
    kind: Panel
    spec:
      display:
        name: Top Clusters
      plugin:
        kind: Table
        spec:
          columnSettings:
            - hide: true
              name: timestamp
            - dataLink:
                openNewTab: true
                title: Drill down
                url: '/monitoring/v2/dashboards/view?dashboard=acm-metrics-cardinality-cluster&project=$__project&var-cluster=${__data.fields["cluster"]}'
              header: Cluster
              name: cluster
            - header: Cardinality
              name: value
          density: compact
      queries:
        - kind: TimeSeriesQuery
          spec:
            plugin:
              kind: PrometheusTimeSeriesQuery
              spec:
                datasource:
                  kind: PrometheusDatasource
                  name: rbac-query-proxy-datasource
                query: 'last_over_time(cluster:cardinality[35m]) > ignoring(cluster) group_left avg(last_over_time(cluster:cardinality[35m])) + 3 * stddev(last_over_time(cluster:cardinality[35m]))'
  '2_0':
    kind: Panel
